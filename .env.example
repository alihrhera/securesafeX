# API Server Configuration
PORT=8787
HOST=0.0.0.0
DATA_DIR=/app/data

# CORS Configuration - update with your domain in production
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=600000

# Storage
MAX_RECORDS=50000

# Proxy Configuration - set to 1 if behind a reverse proxy
TRUST_PROXY=1
